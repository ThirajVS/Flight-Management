# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=aerocadet
DATABASE_USERNAME=aerocadet
DATABASE_PASSWORD=change-me

# Authentication (minimum 32 characters; never commit the real value)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=3600000

# Application
SPRING_PROFILES_ACTIVE=prod
VITE_API_BASE_URL=/api
UPLOAD_DIRECTORY=/app/uploads
DEMO_DATA_ENABLED=true
DEMO_ACCOUNT_PASSWORD=replace-with-a-local-demo-password
CORS_ALLOWED_ORIGINS=http://localhost:8090

# Host ports (chosen to avoid a local Jenkins service on 8080)
APP_HOST_PORT=8090
BACKEND_HOST_PORT=8081
POSTGRES_HOST_PORT=5433

